rules_version = '2';
// Kerangka wajib dari firestore-schema.md (TA Bab III 3.1.2 & Bab IV 4.2.1):
// owner-only read/write; admin lebih luas; field uang/kepemilikan tidak boleh
// ditulis bebas dari klien. Prinsip ini diuji skenario Black-Box #5 dan #6 —
// jangan dilonggarkan.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function role() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function isAdmin() { return isSignedIn() && role() == 'admin'; }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();

      // Alamat tersimpan pelanggan (produk nyata) — hanya pemilik.
      match /alamat/{alamatId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /services/{serviceId} {
      allow read: if true; // katalog publik untuk pengguna yang sudah masuk
      allow write: if isAdmin();
    }

    match /orders/{orderId} {
      // `get` per-dokumen dibuka untuk pengguna masuk: dibutuhkan cek slot
      // deterministik (P5 "kalender slot penuh (disabled)" + Atomic Locking
      // membaca dokumen slot di dalam transaction). Query massal (`list`)
      // tetap owner-only sesuai prinsip skema TA.
      allow get: if isSignedIn();
      allow list: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.cleanerId == request.auth.uid ||
        request.auth.uid in resource.data.kruIds ||
        isAdmin()
      );
      allow create: if isSignedIn() 
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.hargaSatuan == get(/databases/$(database)/documents/services/$(request.resource.data.serviceId)).data.harga
        && request.resource.data.totalHarga == request.resource.data.hargaSatuan * request.resource.data.kuantitas;
      // Skenario Black-Box #6: field uang (totalHarga/hargaSatuan/kuantitas)
      // dan kepemilikan (userId/cleanerId/serviceId/jadwal) TIDAK BISA
      // diubah klien — pelanggan/kru hanya boleh menyentuh status & foto
      // laporan. Perubahan lain hanya oleh admin.
      allow update: if isAdmin() || (
        isSignedIn() &&
        (resource.data.userId == request.auth.uid ||
         resource.data.cleanerId == request.auth.uid ||
         request.auth.uid in resource.data.kruIds) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'fotoSebelum', 'fotoSesudah', 'penugasan'])
      );
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isSignedIn() && (
          get(/databases/$(database)/documents/orders/$(orderId)).data.userId == request.auth.uid ||
          get(/databases/$(database)/documents/orders/$(orderId)).data.cleanerId == request.auth.uid ||
          isAdmin()
        );
        allow write: if isSignedIn() && (
          get(/databases/$(database)/documents/orders/$(orderId)).data.userId == request.auth.uid ||
          get(/databases/$(database)/documents/orders/$(orderId)).data.cleanerId == request.auth.uid ||
          isAdmin()
        );
      }
    }

    match /kru/{cleanerId} {
      allow read: if true;
      allow update: if isOwner(cleanerId) || isAdmin();
      allow create, delete: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin(); // hanya admin yang mengubah statusBayar
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /notifications/{notifId} {
      allow read, update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn(); // idealnya ditulis backend/Cloud Function
    }

    // Koleksi produk NYATA (di luar 7 koleksi TA): promo/voucher.
    // Dibaca untuk pratinjau; dikelola admin. Pelanggan hanya boleh menaikkan
    // `terpakai` tepat +1 saat memakai voucher di dalam transaction pemesanan.
    match /vouchers/{kode} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['terpakai']) &&
        request.resource.data.terpakai == resource.data.terpakai + 1
      );
    }

    // Ledger upah kru (produk nyata). Kru hanya BACA payout miliknya; ia tak
    // pernah menulis nominal. Payout dibuat/diubah lewat transaksi
    // penyelesaian & keputusan admin (uang tak dipercaya klien).
    match /payouts/{payoutId} {
      allow read: if isAdmin() ||
        (isSignedIn() && resource.data.cleanerId == request.auth.uid);
      // Dibuat di dalam transaction penyelesaian oleh kru tertugas; status
      // awal 'pending' dan cleanerId harus milik kru terkait order.
      allow create: if isAdmin() || isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Banding upah/hasil. Kru atau pelanggan membuat; hanya admin memutus.
    match /disputes/{disputeId} {
      allow read: if isAdmin() ||
        (isSignedIn() && resource.data.pengajuId == request.auth.uid);
      allow create: if isSignedIn() &&
        request.resource.data.pengajuId == request.auth.uid &&
        request.resource.data.status == 'diajukan';
      allow update, delete: if isAdmin();
    }
  }
}
